<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>هدية ليكي</title>
<link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#f7e9e4;--paper:#fff8f5;--ink:#3a1620;--rose:#c4475f;--wine:#6b2434;--gold:#c9a36a;--sh:rgba(107,36,52,.18);
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#2a1118;--paper:#3b1a23;--ink:#fbe6e1;--sh:rgba(0,0,0,.4)}}
:root[data-theme="dark"]{--bg:#2a1118;--paper:#3b1a23;--ink:#fbe6e1;--sh:rgba(0,0,0,.4)}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%;margin:0;overflow:hidden;background:var(--bg);color:var(--ink);font-family:Tajawal,system-ui,sans-serif}
.scene{position:absolute;inset:0;display:none;flex-direction:column;align-items:center;justify-content:center;padding:24px 20px 90px;text-align:center}
.scene.on{display:flex;animation:in .9s ease both}
@keyframes in{from{opacity:0;filter:blur(8px)}to{opacity:1;filter:none}}
h1,h2,.script{font-family:'Aref Ruqaa',serif;font-weight:700;margin:0}
button{font:inherit;color:inherit;cursor:pointer;border:0}
button:focus-visible,input:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
.btn{background:linear-gradient(135deg,var(--rose),var(--wine));color:#fff;padding:12px 30px;border-radius:99px;font-weight:700;font-size:1rem;box-shadow:0 8px 22px var(--sh)}
.btn:active{transform:scale(.95)}

/* envelope */
.env{position:relative;width:min(300px,78vw);height:200px;perspective:900px;margin-bottom:34px}
.env .back{position:absolute;inset:0;background:#cdae88;border-radius:6px;box-shadow:0 18px 34px var(--sh)}
.letter{position:absolute;left:8%;right:8%;top:6px;height:170px;background:var(--paper);border-radius:4px;display:flex;align-items:center;justify-content:center;font-family:'Aref Ruqaa';font-size:1.5rem;color:var(--wine);transition:transform 1.1s .5s cubic-bezier(.3,1.2,.4,1);z-index:1}
.front{position:absolute;inset:0;z-index:2;background:linear-gradient(135deg,#dcc09a 50%,transparent 50%) left/50% 100% no-repeat,linear-gradient(225deg,#d6b790 50%,transparent 50%) right/50% 100% no-repeat;border-radius:6px;clip-path:polygon(0 0,50% 55%,100% 0,100% 100%,0 100%)}
.flap{position:absolute;left:0;right:0;top:0;height:60%;background:#bf9f78;clip-path:polygon(0 0,100% 0,50% 100%);transform-origin:top;transition:transform .8s ease,z-index 0s .4s;z-index:4}
.tag{position:absolute;top:34px;left:50%;translate:-50% 0;background:#fffaf4;padding:4px 14px;font-family:'Aref Ruqaa';color:var(--wine);z-index:5;transition:opacity .4s;white-space:nowrap;box-shadow:0 2px 6px var(--sh)}
.seal{position:absolute;top:62px;left:50%;translate:-50% 0;width:54px;height:54px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#e8667c,#9c2a40);z-index:6;display:grid;place-items:center;font-size:1.4rem;box-shadow:0 4px 10px rgba(0,0,0,.3);transition:transform .5s,opacity .5s}
.env.open .flap{transform:rotateX(180deg);z-index:0}
.env.open .letter{transform:translateY(-120px) scale(1.08)}
.env.open .seal,.env.open .tag{opacity:0;transform:scale(1.6) rotate(25deg)}
.env.shake{animation:sh .45s}
@keyframes sh{20%{transform:translateX(-12px) rotate(-2deg)}50%{transform:translateX(12px) rotate(2deg)}80%{transform:translateX(-6px)}}
#word{width:min(240px,70vw);padding:12px 18px;border-radius:99px;border:2px solid var(--gold);background:var(--paper);color:var(--ink);font:inherit;text-align:center;margin:10px 0 16px}
.hint{font-size:.85rem;opacity:.7;margin:0}

/* type scene */
#typed{font-size:1.35rem;line-height:2;min-height:12em;max-width:22em;white-space:pre-line}
#typed::after{content:'';display:inline-block;width:2px;height:1.2em;background:var(--rose);vertical-align:middle;margin-inline-start:3px;animation:bl 1s steps(1) infinite}
@keyframes bl{50%{opacity:0}}
#next{opacity:0;pointer-events:none;transition:opacity .6s}#next.show{opacity:1;pointer-events:auto}

/* hold heart */
.hold{position:relative;width:170px;height:170px;border-radius:50%;background:conic-gradient(var(--rose) calc(var(--p,0)*1%),rgba(196,71,95,.15) 0);display:grid;place-items:center;touch-action:none;user-select:none;-webkit-user-select:none}
.hold::before{content:'';position:absolute;inset:10px;border-radius:50%;background:var(--bg)}
.hold span{position:relative;font-size:4.2rem;transform:scale(calc(1 + var(--p,0)*.012));filter:drop-shadow(0 6px 10px var(--sh));animation:beat 1.2s infinite}
@keyframes beat{50%{translate:0 -4px}}

/* story */
#story{justify-content:flex-start;overflow-y:auto;padding-top:40px;gap:22px}
.box{background:var(--paper);border-radius:22px;padding:18px;width:min(380px,100%);box-shadow:0 10px 26px var(--sh)}
.count{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px}
.count div{background:var(--bg);border-radius:14px;padding:10px 0;font-size:.8rem}
.count b{display:block;font-size:1.6rem;color:var(--rose);font-family:'Aref Ruqaa'}
.card{width:min(340px,86%);aspect-ratio:3/4;perspective:1000px;flex:none;transition:transform .15s linear;cursor:pointer}
.in{position:relative;width:100%;height:100%;transform-style:preserve-3d;transition:transform .8s cubic-bezier(.3,1.3,.5,1)}
.card.flip .in{transform:rotateY(180deg)}
.face{position:absolute;inset:0;backface-visibility:hidden;border-radius:18px;background:var(--paper);padding:12px 12px 48px;box-shadow:0 14px 30px var(--sh)}
.face .ph{width:100%;height:100%;border-radius:10px;background:var(--g) center/cover;display:grid;place-items:center;font-size:3.4rem}
.face small{position:absolute;bottom:14px;left:0;right:0;font-family:'Aref Ruqaa';font-size:1.1rem;color:var(--wine)}
.back2{transform:rotateY(180deg);display:grid;place-items:center;padding:24px;font-family:'Aref Ruqaa';font-size:1.45rem;line-height:1.9;color:var(--wine)}
.cam{position:absolute;top:18px;right:18px;width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.85);z-index:3;font-size:1rem}

/* final */
.msg{min-height:11em;width:min(340px,100%);text-align:right;font-size:1.2rem;line-height:2.4;display:flex;flex-direction:column;gap:4px}

/* player */
#bar{position:fixed;left:12px;right:12px;bottom:calc(12px + env(safe-area-inset-bottom,0px));z-index:50;display:none;align-items:center;gap:12px;background:color-mix(in srgb,var(--paper) 85%,transparent);backdrop-filter:blur(12px);border-radius:99px;padding:8px 14px;box-shadow:0 8px 24px var(--sh);direction:ltr}
#bar.on{display:flex}
#pp{width:38px;height:38px;border-radius:50%;background:var(--rose);color:#fff}
.eq{display:flex;gap:3px;align-items:end;height:20px;margin-inline-start:auto}
.eq i{width:3px;height:100%;background:var(--rose);border-radius:2px;transform-origin:bottom;animation:eq 1s ease-in-out infinite;animation-play-state:paused}
.playing .eq i{animation-play-state:running}
.eq i:nth-child(2){animation-delay:.2s}.eq i:nth-child(3){animation-delay:.5s}.eq i:nth-child(4){animation-delay:.1s}
@keyframes eq{50%{transform:scaleY(.25)}}

/* particles */
.fx{position:fixed;pointer-events:none;z-index:60;animation:fly 1.4s ease-out forwards}
@keyframes fly{to{transform:translate(var(--x),var(--y)) rotate(var(--r));opacity:0}}
.fall{position:fixed;top:-30px;pointer-events:none;z-index:1;animation:fl linear forwards}
@keyframes fl{to{transform:translateY(110vh) rotate(360deg)}}
@media (prefers-reduced-motion:reduce){*{animation-duration:.01s!important;transition-duration:.01s!important}}
</style>
</head>
<body>

<!-- 1: المظروف -->
<section class="scene on" id="s0">
  <div class="env" id="env">
    <div class="back"></div>
    <div class="letter">بحبك 🤍</div>
    <div class="front"></div>
    <div class="flap"></div>
    <div class="tag">my everything ❤️</div>
    <div class="seal">💌</div>
  </div>
  <p class="hint">اكتبي الكلمة السرية</p>
  <input id="word" type="text" autocomplete="off" aria-label="الكلمة السرية" placeholder="••••••">
  <button class="btn" id="unlock">افتحي</button>
  <p class="hint" id="err" style="margin-top:14px;min-height:1.4em"></p>
</section>

<!-- 2: الرسالة -->
<section class="scene" id="s1">
  <div id="typed"></div>
  <button class="btn" id="next">التالي</button>
</section>

<!-- 3: اضغطي واستني -->
<section class="scene" id="s2">
  <h2 style="font-size:2rem;margin-bottom:10px">في حاجة جاية</h2>
  <p class="hint" style="margin-bottom:34px">اضغطي على القلب واستني لحد ما يكتمل</p>
  <div class="hold" id="hold" role="button" tabindex="0" aria-label="اضغطي مطولاً"><span>❣️</span></div>
</section>

<!-- 4: حكايتنا -->
<section class="scene" id="s3"><div id="story" class="scene on" style="display:flex">
  <h2 style="font-size:2.4rem;color:var(--rose)">بدايتنا ❣️</h2>
  <div class="box">
    <div class="script" style="font-size:1.3rem">بقالنا</div>
    <div class="count" id="count"></div>
    <p class="hint" style="margin-top:12px">كل ثانية بتعدي وإنتي في قلبي ❤️</p>
  </div>
  <div class="box" style="padding:12px 18px">يوم ما قولتلك بحبك ❤️ <b id="dt"></b></div>
  <div id="gal" style="display:contents"></div>
  <button class="btn" id="end" style="margin:10px 0 40px">كمّلي 💌</button>
</div></section>

<!-- 5: الختام -->
<section class="scene" id="s4">
  <h2 style="font-size:2.2rem;margin-bottom:18px">💖</h2>
  <div class="box" style="padding:26px 22px"><div class="msg" id="msg"></div></div>
  <button class="btn" id="back" style="margin-top:26px">🔄 memories</button>
  <p class="hint" style="margin-top:14px">دوسي في أي مكان ✨</p>
</section>

<div id="bar" aria-label="مشغل الموسيقى">
  <button id="pp" aria-label="تشغيل أو إيقاف">⏸</button>
  <span id="song" style="font-size:.9rem;direction:rtl"></span>
  <div class="eq"><i></i><i></i><i></i><i></i></div>
</div>
<input type="file" id="file" accept="image/*" hidden>

<script>
/* ====== عدّلي هنا ====== */
const CFG={
  secret:'lola',
  song:'دائماً على بالي 🎵',   // اسم الأغنية اللي بيظهر في الشريط
  start:'2026-04-23',
  intro:['حبيت اعمل هديه جديده','وعايزين نملاه صورنا بقا','بس قبل اي حاجه عايز تعرف','اني بحبك وربنا يخليكي ليا'],
  photos:[
    {e:'🌸',c:'بحبك',g:'linear-gradient(135deg,#e9a7b5,#c4475f)'},
    {e:'🌷',c:'ربنا يخليكي ليا ❤️',g:'linear-gradient(135deg,#f1c27d,#d8704a)'},
    {e:'🌹',c:'أحلى حاجه حصلتلي',g:'linear-gradient(135deg,#a43a52,#4a1524)'},
    {e:'🌙',c:'يوم ميتنسيش 😂',g:'linear-gradient(135deg,#6f7a99,#2f3552)'}
  ],
  last:['بحبك اوي','ربنا يخليكي ليا','وعايزين بقا نملاه صور كتير متنسيش 😂']
};
/* ======================= */
const $=s=>document.querySelector(s),sc=[...document.querySelectorAll('section.scene')];
const go=i=>{sc.forEach((s,k)=>s.classList.toggle('on',k===i));if(i===4)final();if(i===3)tick()};
const wait=ms=>new Promise(r=>setTimeout(r,ms));

/* particles */
function burst(x,y,n=18,set=['❣️','💖','🤍','🌸','✨']){
  for(let i=0;i<n;i++){const e=document.createElement('span'),a=Math.random()*6.28,d=60+Math.random()*130;
    e.className='fx';e.textContent=set[i%set.length];e.style.cssText+=`left:${x}px;top:${y}px;font-size:${14+Math.random()*16}px;--x:${Math.cos(a)*d}px;--y:${Math.sin(a)*d-50}px;--r:${Math.random()*240-120}deg`;
    document.body.append(e);setTimeout(()=>e.remove(),1500)}
}
let rain=0;
function startRain(){if(rain)return;rain=setInterval(()=>{const e=document.createElement('span');e.className='fall';e.textContent='🤎';
  e.style.cssText+=`left:${Math.random()*100}vw;font-size:${14+Math.random()*16}px;animation-duration:${5+Math.random()*5}s`;document.body.append(e);setTimeout(()=>e.remove(),10500)},450)}

/* music */
let ac,playing=false,loop,useFile=true;const audio=new Audio('Music/song.mp3');audio.loop=true;audio.onerror=()=>{useFile=false;if(playing)music(true)};$('#song').textContent=CFG.song;
const notes=[523,587,659,784,880,784,659,587];
function ping(f){const o=ac.createOscillator(),g=ac.createGain();o.type='sine';o.frequency.value=f;
  g.gain.setValueAtTime(0,ac.currentTime);g.gain.linearRampToValueAtTime(.07,ac.currentTime+.05);g.gain.exponentialRampToValueAtTime(.001,ac.currentTime+1.8);
  o.connect(g).connect(ac.destination);o.start();o.stop(ac.currentTime+1.9)}
function music(on){playing=on;$('#bar').classList.toggle('playing',on);$('#pp').textContent=on?'⏸':'▶';clearInterval(loop);audio.pause();
  if(on&&useFile){audio.play().catch(()=>{useFile=false;music(true)});return}
  if(on){ac=ac||new (window.AudioContext||window.webkitAudioContext)();ac.resume();let i=0;loop=setInterval(()=>ping(notes[i++%notes.length]*(i%16<8?1:.75)),700)}}
$('#pp').onclick=()=>music(!playing);

/* 1: unlock */
function unlock(){
  const v=$('#word').value.trim().toLowerCase();
  if(v!==CFG.secret.toLowerCase()){const e=$('#env');e.classList.remove('shake');void e.offsetWidth;e.classList.add('shake');
    $('#err').textContent='مش دي الكلمة، جربي تاني 💭';return}
  const r=$('.seal').getBoundingClientRect();burst(r.left+27,r.top+27,22);
  $('#env').classList.add('open');$('#err').textContent='';$('#bar').classList.add('on');music(true);
  wait(2200).then(()=>go(1)).then(typeIt)
}
$('#unlock').onclick=unlock;$('#word').onkeydown=e=>e.key==='Enter'&&unlock();

/* 2: typewriter */
async function typeIt(){const t=$('#typed');t.textContent='';
  for(const line of CFG.intro){for(const ch of line){t.textContent+=ch;await wait(70)}t.textContent+='\n';await wait(500)}
  $('#next').classList.add('show')}
$('#next').onclick=()=>go(2);

/* 3: hold heart */
const h=$('#hold');let p=0,raf=0,t0=0;
function fill(ts){if(!t0)t0=ts;p=Math.min(100,(ts-t0)/15);h.style.setProperty('--p',p);
  if(p>=100){const r=h.getBoundingClientRect();burst(r.left+85,r.top+85,34);navigator.vibrate&&navigator.vibrate(60);stop();wait(900).then(()=>go(3));return}
  raf=requestAnimationFrame(fill)}
function start(e){e.preventDefault();if(raf)return;t0=0;raf=requestAnimationFrame(fill)}
function stop(){cancelAnimationFrame(raf);raf=0;if(p<100){p=0;h.style.setProperty('--p',0)}}
h.addEventListener('pointerdown',start);['pointerup','pointerleave','pointercancel'].forEach(k=>h.addEventListener(k,stop));
h.onkeydown=e=>(e.key===' '||e.key==='Enter')&&start(e);h.onkeyup=stop;

/* 4: story */
const units=[['يوم',864e5],['ساعة',36e5],['دقيقة',6e4],['ثانية',1e3]];let tm;
function tick(){clearInterval(tm);const d=new Date(CFG.start+'T00:00:00');$('#dt').textContent=CFG.start;
  const f=()=>{let ms=Math.abs(Date.now()-d),out=[];units.forEach(([n,u],i)=>{const q=Math.floor(ms/u);ms-=q*u;out.push(`<div><b>${String(q).padStart(i?2:1,'0')}</b>${n}</div>`)});$('#count').innerHTML=out.join('')};f();tm=setInterval(f,1000)}
CFG.photos.forEach(p=>{const c=document.createElement('div');c.className='card';c.tabIndex=0;
  c.innerHTML=`<div class="in"><div class="face"><button class="cam" aria-label="غيري الصورة">📷</button><div class="ph" style="--g:${p.g}">${p.e}</div><small>${p.c}</small></div><div class="face back2">${p.c}</div></div>`;
  c.onclick=e=>{if(e.target.closest('.cam'))return;c.classList.toggle('flip');const r=c.getBoundingClientRect();burst(r.left+r.width/2,r.top+r.height/2,8,['❤️','✨'])};
  c.querySelector('.cam').onclick=()=>{$('#file').onchange=ev=>{const f=ev.target.files[0];if(f){const ph=c.querySelector('.ph');ph.style.setProperty('--g',`url(${URL.createObjectURL(f)})`);ph.textContent=''}};$('#file').click()};
  $('#gal').append(c)});
$('#story').addEventListener('scroll',()=>{const mid=innerHeight/2;document.querySelectorAll('.card').forEach((c,i)=>{const r=c.getBoundingClientRect();
  const k=Math.max(-1,Math.min(1,(r.top+r.height/2-mid)/(innerHeight*.6)));c.style.transform=`rotate(${k*4*(i%2?1:-1)}deg) scale(${1-Math.abs(k)*.06})`})});
$('#end').onclick=()=>go(4);

/* 5: final */
let fin=0;
async function final(){startRain();const m=$('#msg');m.innerHTML='';const id=++fin;
  for(const l of CFG.last){if(id!==fin)return;const d=document.createElement('div');m.append(d);for(const ch of l){d.textContent+=ch;await wait(60)}await wait(500)}}
$('#back').onclick=()=>{go(3);$('#story').scrollTo({top:0,behavior:'smooth'})};
$('#s4').addEventListener('pointerdown',e=>{if(!e.target.closest('button'))burst(e.clientX,e.clientY,10)});
</script>
</body>
</html>
